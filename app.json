{
  "expo": {
    "name": "Cervelle",
    "slug": "cervelle",
    "owner": "siquanes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cervelle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cervelle.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.cervelle.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF5C8A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE3EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cervelle a besoin de tes photos pour lire tes cours.",
          "cameraPermission": "Cervelle a besoin de l'appareil photo pour photographier tes cours."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cervelle utilise le micro seulement quand tu touches le bouton pour répondre à voix haute.",
          "speechRecognitionPermission": "Cervelle transforme ta réponse dite à voix haute en texte.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "runtimeVersion": "4",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
