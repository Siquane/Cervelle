{
  "expo": {
    "name": "Cervelle",
    "slug": "cervelle",
    "owner": "siquanes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cervelle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cervelle.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.cervelle.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE3EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cervelle a besoin de tes photos pour lire tes cours.",
          "cameraPermission": "Cervelle a besoin de l'appareil photo pour photographier tes cours."
        }
      ]
    ],
    "runtimeVersion": "1",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
