{
  "expo": {
    "name": "Cervelle",
    "slug": "cervelle",
    "owner": "siquanes-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "cervelle",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cervelle.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFE3EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.cervelle.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF5C8A"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE3EC",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cervelle a besoin de tes photos pour lire tes cours.",
          "cameraPermission": "Cervelle a besoin de l'appareil photo pour photographier tes cours."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Cervelle utilise le micro seulement quand tu touches le bouton pour répondre à voix haute.",
          "speechRecognitionPermission": "Cervelle transforme ta réponse dite à voix haute en texte.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./assets/fonts/Outfit_700Bold.ttf",
            "./assets/fonts/AtkinsonHyperlegible_400Regular.ttf",
            "./assets/fonts/AtkinsonHyperlegible_700Bold.ttf"
          ],
          "widgets": [
            {
              "name": "CervelleSerie",
              "label": "Cervelle et ta série",
              "description": "Ta série de jours, la semaine cochée et Cervelle.",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/cervelleserie.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Interro",
              "label": "Prochaine interro",
              "description": "Les jours avant ta prochaine interro, et la révision express.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/interro.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Missions",
              "label": "Missions du jour",
              "description": "Tes missions du jour et tes étoiles du mois.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/missions.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Carte",
              "label": "Carte mémoire du jour",
              "description": "Une carte à retourner chaque jour.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/carte.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Minuteur",
              "label": "Minuteur",
              "description": "Lance une séance de travail en un geste.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/minuteur.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Amis",
              "label": "Mes amis",
              "description": "Tes encouragements et ton défi de la semaine.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/amis.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Express",
              "label": "Révision express",
              "description": "Un bouton pour lancer une révision express.",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/express.png",
              "widgetFeatures": "reconfigurable"
            },
            {
              "name": "Parent",
              "label": "Cervelle · mes enfants",
              "description": "Pour les parents : qui a révisé aujourd'hui, et la prochaine interro de chaque enfant.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "previewImage": "./assets/widgets/parent.png",
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ]
    ],
    "runtimeVersion": "8",
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
